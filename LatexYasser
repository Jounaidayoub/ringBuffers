//Créer et allouer  une nouvelle pile
Pile* Cree_TPile() {
    Pile *Mapile;
    Mapile = (Pile*)malloc(sizeof(Pile));  // Allocation de la memoire
    if (!Mapile) {
        printf("Erreur de memoire ");
        exit(0);
    }
    return Mapile;
}

//Initialiser la pile
int Init_Tpile(Pile *MaPile)
{
    // test  existence de la pile
    if(!MaPile)
    {
        printf("La pile n'existe pas : \n");
        exit(-1);
    }
        MaPile-> sommet = -1 ;
        return((int)1);
}

//Vérifier si la pile est vide
int Est_Vide_Tpile( Pile MaPile)
{

    return((int)MaPile.sommet== -1);

}

int Taille_Tpile( Pile MaPile)
{
    return((int)(MaPile.sommet+1));

}
//Vérifier si la pile est pleine
int Est_Sature_Tpile(Pile MaPile)
{
    return((int) MaPile.sommet==(Elm_Max-1));
}
//Empiler
int Empiler_Tpile( Pile *MaPile , int Valeur)
{
    // test d'existence
    if(!MaPile) { printf("\n n' existe pas");  exit(-1);  }
    // test saturation
    if(Est_Sature_Tpile(*MaPile)) return((int)0);
    MaPile-> Tab[++MaPile->sommet] = Valeur ;
    return((int)1);

}
//Dépiler
int Depiler_Tpile(Pile *MaPile)
{

    if(!MaPile) { printf("\ la pile n'existe pas"); exit(0); }
    // cas ou la pile est vide
    if(Est_Vide_Tpile(*MaPile)) return((int)-1);
    MaPile->sommet--;
    return((int)1);

}
//Afficher
void Afficher_Tpile (Pile MaPile)
{
    if(Est_Vide_Tpile(MaPile)) { printf(" \n la pile est vide"); exit(0); }
    while(MaPile.sommet >= 0 )
        {
            printf("|%d|", MaPile.Tab[MaPile.sommet]);
            Depiler_Tpile(&MaPile);

        }
}      
