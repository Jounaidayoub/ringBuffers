\section{Les files}
\begin{itemize}
    \item Définition de la structure
    \begin{minted}[fontsize=\footnotesize, linenos, frame=lines, breaklines=true, breakanywhere=true]{C}
#define MaxElem 10

typedef struct {
int Tab[MaxElem];
int debut;
int fin;
}TFile;
    \end{minted}
    \item Les fonctions
    \begin{minted}[fontsize=\footnotesize, linenos, frame=lines, breaklines=true, breakanywhere=true]{C}
//Initialisation du file
TFile Init_Tfile(TFile *Mafile)
{
    if(!Mafile){
        printf("erreur allocation");
        exit(-1);
    }
    Mafile->debut=Mafile->fin=-1;
    return((int)1);
}
//creation du file
TFile *Creer_Tfile()
{
    TFile *Mafile;
    //allocation memoire
    Mafile=(TFile*)malloc(sizeof(TFile));
    if(!Mafile){
         printf("erreur allocation");
        exit(-1);
    }
    return((TFile*)Mafile);
}
//Vérifier s'il est vide
int Est_vide_Tfile(TFile *Mafile)
{
    if(Mafile->debut==-1)&&(Mafile->fin==-1)
        return((int)1);
    return((int)0);
}
//Vérifier s'il est pleine
int Est_saturee(TFile *Mafile)
{
    return((int)Mafile->fin-Mafile->debut+1==MaxElem);
}
//Enfiler
int Enfiler_Tfile(TFile *Mafile, int valeur)
{
    //si la file n'existe pas
    if(!Mafile){
        printf("Erreur");
        exit(-1);
    }
    if(Est_saturee(*Mafile))
        return((int)-1);
    if(Est_vide_Tfile(*Mafile)){
        Mafile->Tab[0]=valeur;
        Mafile->debut=Mafile->fin=0;
        return((int)2);
    }

}
//Défiler
int Defiler_Tfile(TFile *Mafile)
{
    if(!Mafile){
        printf("Erreur allocation");
        return((int)-2);
    }
    if(Est_vide_Tfile(Mafile))
        return((int)-1);
    //si la file contient un seul élement
    if(Mafile->debut==Mafile->fin)
        Init_Tfile(Mafile);
    Mafile->debut++;
    return((int)1);
}
int Taille_Tfile(TFile *Mafile)
{
    return((int)(Mafile->fin - Mafile->debut+1));
}
// Affichage du contenu de la file
void Afficher_Tfile(TFile *Mafile)
{
    int i;
    
    // Vérifier si la file existe
    if(!Mafile) {
        printf("Erreur: File inexistante\n");
        return;
    }
    
    // Vérifier si la file est vide
    if(Est_vide_Tfile(Mafile)) {
        printf("La file est vide\n");
        return;
    }
    
    // Afficher les informations de la file
    printf("Contenu de la file:\n");
    printf("Debut: %d, Fin: %d, Taille: %d\n", 
           Mafile->debut, Mafile->fin, Taille_Tfile(Mafile));
    
    printf("Elements: [ ");
    for(i = Mafile->debut; i <= Mafile->fin; i++) {
        printf("%d ", Mafile->Tab[i]);
    }
    printf("]\n");
}

