\section{Les Listes}
\begin{itemize}
    \item Définition de la structure
    \begin{minted}[fontsize=\footnotesize, linenos, frame=lines, breaklines=true, breakanywhere=true]{C}
    #define max_elem 20
    //structure de la liste
    typedef struct
    {
       int tab[max_elem];
       int ind_DR;
    } Liste;
        
    \end{minted}
    \item Les fonctions
    \begin{minted}[fontsize=\footnotesize, linenos, frame=lines, breaklines=true, breakanywhere=true]{C}
//Initialisation
int Init_TListe(Liste *Maliste)
{
  if (!Maliste)
  {
    printf("la liste n'existe pas");
    exit(-1);
  }
  Maliste->ind_DR = -1;
  return 1;
}

//Liste est vide
int Est_Vide_TListe(Liste Maliste)
{
  return (Maliste.ind_DR == -1);
}

//Taille
int Taille_TListe(Liste Maliste)
{
  return Maliste.ind_DR + 1;
}

//Insertion
int Inserer_TListe( Liste *Maliste,int elm, int pos)
{
  if (pos >Taille_TListe(*Maliste) || pos < 0) {
    printf("\nLa position est invalide ");
    return 0;
  }
  if (Maliste->ind_DR >= max_elem - 1) {
    printf("\nListe pleine");
    return 0;
  }

  int ind;
  for (ind = Maliste->ind_DR; ind >= pos; ind--) {
    Maliste->tab[ind + 1] = Maliste->tab[ind];
  }
  Maliste->tab[pos] = elm;
  Maliste->ind_DR++;
  return 1;
}

//Supprimer
int Supprimer_TListe(Liste *Maliste ,int pos)
{
  if (Est_Vide_TListe(*Maliste) || pos < 0 || pos > Maliste->ind_DR)
    exit(-1);

  int ind;
  for (ind = pos; ind < Maliste->ind_DR; ind++)
  {
    Maliste->tab[ind] = Maliste->tab[ind + 1];
  }
  Maliste->ind_DR--;
  return 1;
}
//Afficher
void Afficher_TListe(Liste Maliste)
{
  if (Est_Vide_TListe(Maliste)) {
    printf("\nListe vide\n");
    return;
  }
  printf("\nContenu de la liste: [");
  int ind;
  for (ind = 0; ind <= Maliste.ind_DR; ind++) {
    printf("%d", Maliste.tab[ind]);
    if (ind < Maliste.ind_DR)
      printf(", ");
  }
  printf("]\n");
}
        
    \end{minted}
\end{itemize}
